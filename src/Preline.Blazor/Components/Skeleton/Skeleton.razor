@namespace Preline.Blazor.Components
@inherits PrelineComponentBase

<div @attributes="AdditionalAttributes" class="@(Animation ? "animate-pulse" : "")">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Animation { get; set; } = true;

    private string Class => new CssBuilder()
        .Add("animate-pulse", Animation)
        .Add(AdditionalAttributes)
        .Build();
}
